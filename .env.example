# LLM API Keys
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# Alternate name also supported by backend:
# GOOGLE_API_KEY=your_gemini_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/qa_copilot

# Zoho Integration
ZOHO_API_KEY=your_zoho_key_here
ZOHO_ORG_ID=your_org_id_here

# Application
APP_HOST=0.0.0.0
APP_PORT=8000

# Appium server endpoint (supports both http://host:port and /wd/hub fallback)
APPIUM_SERVER_URL=http://localhost:4723

# Execution profile for test preconditions
COMPANY_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TEST_USER_USERNAME=
TEST_USER_PASSWORD=

# Optional precondition backend (choose one)
PRECONDITION_API_URL=

# SQL templates for DB-driven preconditions
# Available placeholders: {setting}, {enabled}, {company_url}, {admin_username}
PRECONDITION_SQL_ENABLE_TEMPLATE=UPDATE feature_flags SET enabled=1 WHERE key='{setting}';
PRECONDITION_SQL_DISABLE_TEMPLATE=UPDATE feature_flags SET enabled=0 WHERE key='{setting}';
